{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Productivity Command Center",
  "version": "0.1.0",
  "identifier": "com.apcc.productivity",
  "build": {
    "beforeDevCommand": "cd ../web && npm run dev",
    "beforeBuildCommand": "cd ../web && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "title": "AI Productivity Command Center", "width": 1200, "height": 800, "minWidth": 360, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; img-src 'self' data:;" }
  },
  "bundle": { "active": true, "targets": "all" }
}
